# /etc/flightctl/meshsa-ui.env — meshsa operator console environment
# Install: sudo install -m 640 -o root -g flightctl this-file /etc/flightctl/meshsa-ui.env
# The file must be readable by the flightctl service user (group-readable, chmod 640).
# NEVER commit a real token to version control.  Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ── master switch ───────────────────────────────────────────────────────────
# The console is off by default; set to true to enable.
MESHSA_UI_ENABLED=true

# ── network bind ────────────────────────────────────────────────────────────
# Default: loopback only.  For field LAN access set to the node's LAN address
# (e.g. 192.168.1.10) AND set a strong MESHSA_UI_TOKEN below.  A non-loopback
# bind without a token will refuse to start (fail-closed).
MESHSA_UI_HOST=127.0.0.1
MESHSA_UI_PORT=8100

# ── authentication ──────────────────────────────────────────────────────────
# Required when MESHSA_UI_HOST is not a loopback address.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MESHSA_UI_TOKEN=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ── map tiles ───────────────────────────────────────────────────────────────
# Default: demotiles.maplibre.org (requires internet).
# For fully offline field use, serve the MapLibre assets locally and point here.
# MESHSA_UI_MAP_STYLE_URL=http://127.0.0.1:8101/style.json
MESHSA_UI_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# ── poll / staleness / caps ──────────────────────────────────────────────────
# All values are config-driven; defaults shown.  Tune for your node capacity
# before raising the systemd MemoryMax limit.
MESHSA_UI_POLL_INTERVAL_S=2.0
MESHSA_UI_TRACK_STALE_S=300.0
MESHSA_UI_DETECTION_STALE_S=3600.0
MESHSA_UI_MAX_TRACKS=256
MESHSA_UI_MAX_DETECTIONS=1024

# ── optional panels ──────────────────────────────────────────────────────────
# Chat panel (requires the [llm] extra and MESHSA_LLM_* config).
MESHSA_UI_CHAT_ENABLED=false

# Log-tail panel.  Enable for ops troubleshooting; disable in normal operation
# (the ring adds a small allocation per entry at the capture floor).
MESHSA_UI_LOG_RING_ENABLED=false
MESHSA_UI_LOG_RING_SIZE=200
MESHSA_UI_LOG_RING_LEVEL=info

# ── observability format ─────────────────────────────────────────────────────
# "json" (default) or "prometheus" (for /metrics scraping with Grafana).
MESHSA_UI_METRICS_FORMAT=json

# ── page title ───────────────────────────────────────────────────────────────
MESHSA_UI_TITLE=MeshSA Operator

# ── node identity (required by the meshsa node) ──────────────────────────────
MESHSA_UID=gcs-node-01
MESHSA_CALLSIGN=GCS01
MESHSA_LOG_LEVEL=INFO
